// Diagrama ER de GymDB (crow's foot). Regenerar con Graphviz:
//   dot -Tpng -Gdpi=190 Diagrama_ER_GymDB.dot -o Diagrama_ER_GymDB.png
// Cada relación sale de la PK de la tabla padre y llega a la columna FK de la tabla hija.
digraph ER_GymDB {
	bgcolor=white pad=0.35 rankdir=LR ranksep=1.3 nodesep=0.6 splines=spline fontname="Arial"
	node [shape=plain fontname="Arial"]
	edge [color="#4E728C" penwidth=1.5 arrowsize=0.9 fontname="Arial" fontsize=9 fontcolor="#4E728C" dir=both arrowtail=teetee arrowhead=crowodot]
	Socios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B6C4D3"><TR><TD COLSPAN="3" BGCOLOR="#225F78" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B>gym.Socios</B></FONT></TD></TR><TR><TD PORT="id_socio_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><B>id_socio</B></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD PORT="id_socio_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT IDENTITY(1,1)</FONT></TD></TR><TR><TD PORT="nombre_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">nombre</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="nombre_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="apellido_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">apellido</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"> </TD><TD PORT="apellido_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="correo_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">correo</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD PORT="correo_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(150)</FONT></TD></TR><TR><TD PORT="telefono_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">telefono</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"> </TD><TD PORT="telefono_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(20) NULL</FONT></TD></TR><TR><TD PORT="fecha_registro_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">fecha_registro</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="fecha_registro_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">DATE</FONT></TD></TR></TABLE>>]
	Entrenadores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B6C4D3"><TR><TD COLSPAN="3" BGCOLOR="#225F78" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B>gym.Entrenadores</B></FONT></TD></TR><TR><TD PORT="id_entrenador_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><B>id_entrenador</B></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD PORT="id_entrenador_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT IDENTITY(1,1)</FONT></TD></TR><TR><TD PORT="nombre_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">nombre</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="nombre_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="apellido_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">apellido</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"> </TD><TD PORT="apellido_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="especialidad_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">especialidad</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="especialidad_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="telefono_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">telefono</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"> </TD><TD PORT="telefono_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(20) NULL</FONT></TD></TR></TABLE>>]
	Clases [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B6C4D3"><TR><TD COLSPAN="3" BGCOLOR="#225F78" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B>gym.Clases</B></FONT></TD></TR><TR><TD PORT="id_clase_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><B>id_clase</B></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD PORT="id_clase_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT IDENTITY(1,1)</FONT></TD></TR><TR><TD PORT="nombre_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">nombre</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="nombre_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="descripcion_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">descripcion</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"> </TD><TD PORT="descripcion_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(255) NULL</FONT></TD></TR><TR><TD PORT="duracion_minutos_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">duracion_minutos</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9"><B>CK</B></FONT></TD><TD PORT="duracion_minutos_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">INT</FONT></TD></TR></TABLE>>]
	Horarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B6C4D3"><TR><TD COLSPAN="3" BGCOLOR="#225F78" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B>gym.Horarios</B></FONT></TD></TR><TR><TD PORT="id_horario_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><B>id_horario</B></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD PORT="id_horario_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT IDENTITY(1,1)</FONT></TD></TR><TR><TD PORT="id_clase_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10"><I>id_clase</I></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"><FONT COLOR="#2E7D32" POINT-SIZE="9"><B>FK</B></FONT></TD><TD PORT="id_clase_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD PORT="id_entrenador_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><I>id_entrenador</I></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#2E7D32" POINT-SIZE="9"><B>FK</B></FONT></TD><TD PORT="id_entrenador_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD PORT="fecha_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">fecha</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="fecha_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD PORT="hora_inicio_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">hora_inicio</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"> </TD><TD PORT="hora_inicio_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">TIME(0)</FONT></TD></TR><TR><TD PORT="cupo_maximo_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">cupo_maximo</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9"><B>CK</B></FONT></TD><TD PORT="cupo_maximo_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">INT</FONT></TD></TR></TABLE>>]
	Reservas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B6C4D3"><TR><TD COLSPAN="3" BGCOLOR="#225F78" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B>gym.Reservas</B></FONT></TD></TR><TR><TD PORT="id_reserva_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><B>id_reserva</B></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD PORT="id_reserva_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT IDENTITY(1,1)</FONT></TD></TR><TR><TD PORT="id_socio_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10"><I>id_socio</I></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"><FONT COLOR="#2E7D32" POINT-SIZE="9"><B>FK</B></FONT></TD><TD PORT="id_socio_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD PORT="id_horario_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><I>id_horario</I></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#2E7D32" POINT-SIZE="9"><B>FK</B></FONT></TD><TD PORT="id_horario_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD PORT="fecha_reserva_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">fecha_reserva</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="fecha_reserva_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">DATETIME2(0)</FONT></TD></TR><TR><TD PORT="estado_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">estado</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9"><B>CK</B></FONT></TD><TD PORT="estado_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(20)</FONT></TD></TR></TABLE>>]
	Pagos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B6C4D3"><TR><TD COLSPAN="3" BGCOLOR="#7256A3" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B>finanzas.Pagos</B></FONT></TD></TR><TR><TD PORT="id_pago_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10"><B>id_pago</B></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD PORT="id_pago_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">INT IDENTITY(1,1)</FONT></TD></TR><TR><TD PORT="id_socio_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10"><I>id_socio</I></FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"><FONT COLOR="#2E7D32" POINT-SIZE="9"><B>FK</B></FONT></TD><TD PORT="id_socio_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD PORT="monto_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">monto</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9"><B>CK</B></FONT></TD><TD PORT="monto_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">DECIMAL(10,2)</FONT></TD></TR><TR><TD PORT="fecha_pago_w" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">fecha_pago</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#FFFFFF"> </TD><TD PORT="fecha_pago_e" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT COLOR="#587189" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD PORT="metodo_pago_w" ALIGN="LEFT" BGCOLOR="#F0F4F8"><FONT POINT-SIZE="10">metodo_pago</FONT></TD><TD ALIGN="CENTER" BGCOLOR="#F0F4F8"> </TD><TD PORT="metodo_pago_e" ALIGN="RIGHT" BGCOLOR="#F0F4F8"><FONT COLOR="#587189" POINT-SIZE="9">VARCHAR(30)</FONT></TD></TR></TABLE>>]
	{ rank=same; Clases; Entrenadores; Socios }
	{ rank=same; Horarios; Pagos }
	Clases:id_clase_e:e -> Horarios:id_clase_w:w [taillabel=" 1 " headlabel=" N " labeldistance=1.8 labelangle=35 tooltip="FK_Horarios_Clases"]
	Entrenadores:id_entrenador_e:e -> Horarios:id_entrenador_w:w [taillabel=" 1 " headlabel=" N " labeldistance=1.8 labelangle=35 tooltip="FK_Horarios_Entrenadores"]
	Horarios:id_horario_e:e -> Reservas:id_horario_w:w [taillabel=" 1 " headlabel=" N " labeldistance=1.8 labelangle=35 tooltip="FK_Reservas_Horarios"]
	Socios:id_socio_e:e -> Reservas:id_socio_w:w [taillabel=" 1 " headlabel=" N " labeldistance=1.8 labelangle=35 tooltip="FK_Reservas_Socios"]
	Socios:id_socio_e:e -> Pagos:id_socio_w:w [taillabel=" 1 " headlabel=" N " labeldistance=1.8 labelangle=35 tooltip="FK_Pagos_Socios"]
	legend [label=<<TABLE BORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#587189">PK clave primaria · FK clave foránea · UQ única · CK regla CHECK<BR ALIGN="LEFT"/>Línea: ‖ uno (padre) — ○&lt; cero o muchos (hija)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	{ rank=same; Reservas; legend }
	Reservas -> legend [style=invis]
}
